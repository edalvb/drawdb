VITE_BACKEND_URL=http://backend.com

# Google Drive integration (optional).
# Create an OAuth Client ID (Web) and an API key in Google Cloud Console,
# enable the "Google Drive API" and "Google Picker API", and add your dev
# origin (e.g. http://localhost:5173) to the OAuth client's authorized origins.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Optional: your Google Cloud project number, used by the Picker.
VITE_GOOGLE_APP_ID=
